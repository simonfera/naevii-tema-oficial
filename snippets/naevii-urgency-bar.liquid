{% comment %}
  Urgency Bar - Naevii
  Usage: {% render 'naevii-urgency-bar' %}
{% endcomment %}

{% if product.handle contains 'limitless' or product.handle contains 'limtless' %}
<style>
  .naevii-urgency-bar {
    background-color: #f9f7f4;
    border: 1px solid #e8e4de;
    border-radius: 12px;
    padding: 16px;
    margin: 24px 0;
    font-family: inherit;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }
  .naevii-urgency-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .naevii-urgency-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #7A6E63;
    text-transform: uppercase;
  }
  .naevii-pulse-dot {
    position: relative;
    display: flex;
    height: 10px;
    width: 10px;
    flex-shrink: 0;
  }
  .naevii-pulse-dot span.ping {
    animation: naevii-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    position: absolute;
    display: inline-flex;
    height: 100%;
    width: 100%;
    border-radius: 50%;
    background-color: #7A6E63;
    opacity: 0.6;
  }
  .naevii-pulse-dot span.dot {
    position: relative;
    display: inline-flex;
    border-radius: 50%;
    height: 10px;
    width: 10px;
    background-color: #7A6E63;
  }
  .naevii-sold-text {
    font-size: 11px;
    font-weight: 500;
    color: #888;
  }
  .naevii-progress-bg {
    width: 100%;
    height: 8px;
    background-color: #e8e4de;
    border-radius: 9999px;
    overflow: hidden;
  }
  .naevii-progress-fill {
    height: 100%;
    background-color: #7A6E63;
    border-radius: 9999px;
    transition: width 1s ease-out;
    position: relative;
    overflow: hidden;
    width: 82%; /* (41/50)*100 */
  }
  .naevii-progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.2);
    animation: naevii-pulse-bar 2s ease-in-out infinite;
  }
  .naevii-urgency-footer {
    margin-top: 14px;
    font-size: 12px;
    color: #7A6E63;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }
  .naevii-urgency-footer svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  
  @keyframes naevii-ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }
  @keyframes naevii-pulse-bar {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
  }
</style>

<div class="naevii-urgency-bar">
  <div class="naevii-urgency-header">
    <span class="naevii-urgency-label">
      <span class="naevii-pulse-dot">
        <span class="ping"></span>
        <span class="dot"></span>
      </span>
      LAST 9 FREE GIFTS AVAILABLE
    </span>
    <span class="naevii-sold-text">41/50 sold</span>
  </div>

  <div class="naevii-progress-bg">
    <div class="naevii-progress-fill"></div>
  </div>

  <div class="naevii-urgency-footer">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
    </svg>
    Free gift included with your order
  </div>
</div>
{% endif %}
