{% comment %}
  NAEVII Custom Footer (Migrated from Lovable)
{% endcomment %}
<style>
  .naevii-footer {
    background-color: var(--forest-dark);
    color: var(--cream);
    padding: 64px 24px;
    font-family: var(--font-body);
  }
  .naevii-footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media(min-width: 640px) {
    .naevii-footer-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media(min-width: 1024px) {
    .naevii-footer-container {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .naevii-footer h4 {
    color: var(--cream) !important;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .naevii-footer p {
    color: rgba(245, 243, 239, 0.6);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 16px;
    font-style: italic;
  }
  .naevii-footer a {
    color: rgba(245, 243, 239, 0.5);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s;
    display: block;
    margin-bottom: 12px;
  }
  .naevii-footer a:hover {
    color: var(--cream);
  }
  .naevii-footer-input-group {
    display: flex;
    border: 1px solid rgba(245, 243, 239, 0.3);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .naevii-footer-input-group input {
    background: transparent;
    border: none;
    color: var(--cream);
    padding: 12px 16px;
    flex: 1;
    font-size: 0.875rem;
    outline: none;
  }
  .naevii-footer-input-group input::placeholder {
    color: rgba(245, 243, 239, 0.4);
  }
  .naevii-footer-input-group button {
    background: transparent;
    border: none;
    color: rgba(245, 243, 239, 0.5);
    padding: 12px 16px;
    cursor: pointer;
    transition: color 0.2s;
  }
  .naevii-footer-input-group button:hover {
    color: var(--cream);
  }
  .naevii-footer-socials {
    display: flex;
    gap: 20px;
  }
  .naevii-footer-bottom {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid rgba(245, 243, 239, 0.1);
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .naevii-footer-bottom p {
    margin: 0;
    font-style: normal;
    color: rgba(245, 243, 239, 0.3);
  }
  .naevii-payment-icons {
    display: flex;
    gap: 8px;
  }
  .naevii-payment-icons svg {
    width: 38px;
    height: 24px;
    opacity: 0.5;
    filter: grayscale(100%);
    transition: all 0.3s;
  }
  .naevii-payment-icons svg:hover {
    opacity: 1;
    filter: grayscale(0%);
  }
</style>

<footer class="naevii-footer">
  <div class="naevii-footer-container">
    <div>
      <h4>About Us</h4>
      <p>NAEVII was created for those who cherish the beauty of beginnings.</p>
      <p>Since its first steps, our purpose has been to bring softness, comfort, and meaning to every little moment of childhood.</p>
      <p>Each piece blends timeless design with gentle care, crafted to embrace babies with safety, love, and calm.</p>
      <p>Because little moments grow fast, but the feeling they leave lasts forever.</p>
    </div>
    
    <div>
      <h4>Policies</h4>
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <a href="/policies/refund-policy">Refund Policy</a>
      <a href="/policies/shipping-policy">Shipping Policy</a>
      <a href="/policies/terms-of-service">Terms of Service</a>
    </div>

    <div>
      <h4>Contact</h4>
      <a href="mailto:support@naevii.com">support@naevii.com</a>
      <a href="/pages/contact">Contact Information</a>
    </div>

    <div>
      <h4>Sign up for new stories and personal offers</h4>
      {% form 'customer', class: 'naevii-footer-input-group' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="E-mail" required>
        <button type="submit" aria-label="Subscribe">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>
      {% endform %}
      <div class="naevii-footer-socials">
        <a href="{{ settings.social_facebook_link }}" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="{{ settings.social_instagram_link }}" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="naevii-footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }}, NAEVII.</p>
    {%- unless shop.enabled_payment_types == empty -%}
      <div class="naevii-payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
    {%- endunless -%}
  </div>
</footer>

{% schema %}
{
  "name": "NAEVII Footer",
  "settings": []
}
{% endschema %}
